{
  "$schema": "node_modules/konsistent/konsistent.schema.json",
  "version": "v1",
  "conventions": [
    {
      "name": "docs-route-handlers",
      "description": "Docs route modules expose read-only GET handlers backed by the shared content source.",
      "paths": "apps/docs/app/**/route.{ts,tsx}",
      "must": {
        "exportValues": ["GET"],
        "importValues": [
          {
            "name": "source",
            "from": "@/lib/source"
          }
        ]
      }
    }
  ]
}
