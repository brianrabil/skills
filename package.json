{
  "name": "brianrabil-skills",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianrabil/skills.git"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "agent:dev": "turbo run dev --filter=agent",
    "build": "turbo run build",
    "lint": "oxlint .",
    "konsistent": "konsistent",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check",
    "skills:sync": "skills experimental_install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "konsistent": "^1.0.0-beta.9",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "skills": "^1.5.14",
    "turbo": "^2.5.0"
  },
  "overrides": {
    "postcss@<8.5.10": "8.5.16"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
